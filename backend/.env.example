# --- Backend FastAPI · copiar a backend/.env ------------------------------

# Clave de firma de los JWT. OBLIGATORIO cambiarla en produccion.
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Base de datos. En Vercel se usa sqlite:////tmp/punto_limpio.db automaticamente.
DATABASE_URL=sqlite:///./punto_limpio.db

# Origenes permitidos por CORS (el frontend Django).
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Modelo de ML.
# Ruta opcional a un MobileNetV2 afinado con TrashNet (*.h5 / *.keras).
# Si esta vacia se usa MobileNetV2 de ImageNet; sin TensorFlow, el respaldo.
TRASHNET_MODEL_PATH=
IMAGE_SIZE=224

# Limites de carga.
# 4 MB: alineado con el limite de 4.5 MB del cuerpo en las funciones de Vercel.
MAX_UPLOAD_MB=4
MAX_IMAGE_PIXELS=4000

DEBUG=true
