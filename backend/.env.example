[TEMPLATE]
# --- Backend FastAPI · copiar a backend/.env ------------------------------

# Clave de firma de los JWT. OBLIGATORIO cambiarla en produccion.
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Base de datos. En Railway, si el servicio tiene un volumen montado en
# /app/data, se usa sqlite:////app/data/ecoscan.db automaticamente.
# En local se usa un archivo junto al backend.
DATABASE_URL=sqlite:///./ecoscan.db

# Origenes permitidos por CORS (el frontend Django). En Railway, agrega la
# URL publica del servicio frontend (ej. https://ecoscan-web.up.railway.app).
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Modelo de ML.
# Ruta opcional a un MobileNetV2 afinado con TrashNet (*.h5 / *.keras).
# Si esta vacia se usa MobileNetV2 de ImageNet; sin TensorFlow, el respaldo.
TRASHNET_MODEL_PATH=
IMAGE_SIZE=224

# Limites de carga.
# 25 MB por defecto (Railway no tiene el corte de 4.5 MB de Vercel). Debe
# coincidir con MAX_UPLOAD_BYTES del frontend.
MAX_UPLOAD_MB=25
MAX_IMAGE_PIXELS=4000

DEBUG=false
