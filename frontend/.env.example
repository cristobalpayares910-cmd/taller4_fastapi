[TEMPLATE]
# --- Frontend Django · copiar a frontend/.env -----------------------------

# Clave de firma de la sesion (cookies firmadas). En produccion es
# OBLIGATORIO definirla y mantenerla fija: si cambia, las sesiones se
# invalidan.
DJANGO_SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria

# Modo desarrollo del frontend. En Railway (o cualquier entorno publico) usar
# 0. OJO con el nombre: la variable del frontend es DJANGO_DEBUG; DEBUG es la
# del backend y Django la ignora por completo.
DJANGO_DEBUG=false

# En Railway, cuando DJANGO_DEBUG=0 este valor es obligatorio con los dominios
# publicos del servicio, ej: .up.railway.app (la coma separa varios valores).
ALLOWED_HOSTS=localhost,127.0.0.1
# Dominios de confianza para el CSRF, ej: https://ecoscan-web.up.railway.app
CSRF_TRUSTED_ORIGINS=

# URL publica del backend FastAPI. En Railway apunta al dominio del servicio
# backend, ej: https://ecoscan-api.up.railway.app
FASTAPI_BASE_URL=http://127.0.0.1:8001
FASTAPI_TIMEOUT=45

# Limite de subida aceptado por Django antes de reenviar la imagen.
# 25 MiB por defecto; debe coincidir con MAX_UPLOAD_MB del backend.
MAX_UPLOAD_BYTES=26214400
