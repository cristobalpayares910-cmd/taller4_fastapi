# --- Frontend Django · copiar a frontend/.env -----------------------------

# Clave de firma de la sesion (cookies firmadas). En Vercel es OBLIGATORIO
# definirla: si cambia entre arranques en frio, las sesiones se invalidan.
DJANGO_SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria

# Modo desarrollo del frontend. En Vercel (o cualquier entorno publico) usar 0.
# OJO con el nombre: la variable del frontend es DJANGO_DEBUG; DEBUG es la del
# backend y Django la ignora por completo.
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
# Dominios de confianza para el CSRF (en Vercel: https://tu-proyecto.vercel.app)
CSRF_TRUSTED_ORIGINS=

# URL publica del backend FastAPI.
FASTAPI_BASE_URL=http://127.0.0.1:8001
FASTAPI_TIMEOUT=45

# Limite de subida aceptado por Django antes de reenviar la imagen.
# 4 MiB: las funciones de Vercel cortan el cuerpo de la peticion en 4.5 MB, asi
# que un limite mayor nunca se alcanza y el usuario ve un 413 del proveedor.
MAX_UPLOAD_BYTES=4194304
